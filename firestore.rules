rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Только владелец (впишите свой email) может читать и менять данные
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "ВАШ_EMAIL@gmail.com";
    }
  }
}
